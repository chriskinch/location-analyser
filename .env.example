# Google OAuth 2.0 credentials
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or select an existing one)
# 3. Go to APIs & Services > Credentials > Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Add http://127.0.0.1:3000/auth/callback as an authorised redirect URI
# 6. Copy the client ID and secret below
# Note: no extra Google APIs need to be enabled — OAuth 2.0 / OpenID Connect
#       is available on all projects by default.

GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Override host/port/redirect URI when running behind a proxy or HTTPS
# HOST=127.0.0.1
# PORT=3000
# REDIRECT_URI=https://example.com/auth/callback

# Set to true only when running behind HTTPS (adds the Secure flag to cookies)
# COOKIE_SECURE=true
